    "@types/node": "^25.3.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-webdriverio": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dompurify": "^3.3.2",
    "esbuild": "^0.27.3",
    "esbuild-plugin-minify-html-literals": "^3.0.0",
    "focus-trap": "^8.0.0",
    "glob": "^13.0.6",
    "jsdom": "^28.1.0",
    "lit": "^3.3.2",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
